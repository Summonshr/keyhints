{
  "name": "keyhints",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "check": "npm run typecheck && npm test && npm run e2e",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
